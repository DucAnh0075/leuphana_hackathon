# Lokale synthetische Vorführung braucht keine Umgebungsvariablen.
# Für echte VORA-Chatantworten: nur serverseitig, nie NEXT_PUBLIC_ voranstellen.
OPENAI_API_KEY=
# Optionales Modell; Standard gpt-4.1-mini. VORA_AI_MODEL hat Vorrang vor OPENAI_MODEL.
VORA_AI_MODEL=
# OPENAI_MODEL=

# Für den echten Anschluss: separates Supabase-Demo-/Testprojekt verwenden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativ unterstützt: vorhandener öffentlicher anon-Key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur für scripts/seed-care.mjs --apply; niemals NEXT_PUBLIC_ voranstellen.
# Der normale App-Betrieb benötigt keinen Service-Key.
SUPABASE_SERVICE_ROLE_KEY=
CARE_OWNER_USER_ID=
CARE_CLINIC_USER_ID=
